{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [

        // ── Blink Green (LD4, PD12) ──────────────────────────────────────────
        {
            "label": "Configure - Blink Green [Debug]",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/blink_green"
            },
            "command": "cmake",
            "args": [
                "-B./build",
                "-GNinja",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/shared/arm-none-eabi-gcc.cmake",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Configure - Blink Green [Release]",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/blink_green"
            },
            "command": "cmake",
            "args": [
                "-B./build",
                "-GNinja",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/shared/arm-none-eabi-gcc.cmake",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build - Blink Green",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/blink_green/build"
            },
            "command": "ninja",
            "problemMatcher": []
        },

        // ── Blink Orange (LD3, PD13) ─────────────────────────────────────────
        {
            "label": "Configure - Blink Orange [Debug]",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/blink_orange"
            },
            "command": "cmake",
            "args": [
                "-B./build",
                "-GNinja",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/shared/arm-none-eabi-gcc.cmake",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Configure - Blink Orange [Release]",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/blink_orange"
            },
            "command": "cmake",
            "args": [
                "-B./build",
                "-GNinja",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/shared/arm-none-eabi-gcc.cmake",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build - Blink Orange",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/blink_orange/build"
            },
            "command": "ninja",
            "problemMatcher": []
        },

        // ── Firmware Unit Tests ──────────────────────────────────────────────
        {
            "label": "Configure - Unit Tests",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "cmake",
            "args": [
                "-B./build",
                "-GNinja",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build - Unit Tests",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "command": "ninja",
            "problemMatcher": []
        },
        {
            "label": "Run - Unit Tests",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build/tests"
            },
            "command": "./TestRunner",
            "problemMatcher": []
        },
        {
            // https://www.gcovr.com/en/stable/guide.html
            "label": "Coverage - Unit Tests",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/shared"
            },
            "command": "gcovr",
            "args": [
                "-r", ".",
                "--object-directory", "${workspaceFolder}/build/tests/CMakeFiles/TestRunner.dir",
                "--html-details",
                "-o", "${workspaceFolder}/build/coverage.html",
                "-j", "4"
            ],
            "problemMatcher": []
        },

        // ── Host Unit Tests (C++ / GoogleTest — Phase 1 reference) ────────────
        {
            "label": "Configure - Host Tests (C++)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/host"
            },
            "command": "cmake",
            "args": [
                "-B./build",
                "-GNinja",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build - Host Tests (C++)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/host/build"
            },
            "command": "ninja",
            "problemMatcher": []
        },
        {
            "label": "Run - Host Tests (C++)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/host/build/tests"
            },
            "command": "./TestRunnerHost",
            "problemMatcher": []
        },
        {
            "label": "Coverage - Host Tests (C++)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/host/src"
            },
            "command": "gcovr",
            "args": [
                "-r", ".",
                "--object-directory", "${workspaceFolder}/host/build/tests/CMakeFiles/TestRunnerHost.dir",
                "--html-details",
                "-o", "${workspaceFolder}/host/build/coverage.html",
                "-j", "4"
            ],
            "problemMatcher": []
        },

        // ── Host Application (.NET 8) ───────────────────────────────────────
        {
            "label": "Build - Host App (.NET)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/host"
            },
            "command": "dotnet",
            "args": ["build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Test - Host App (.NET)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/host"
            },
            "command": "dotnet",
            "args": ["test", "--verbosity", "normal"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run - Host App (.NET)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/host"
            },
            "command": "dotnet",
            "args": ["run", "--project", "BootloaderTool"],
            "problemMatcher": []
        },
        {
            "label": "Clean - Host App (.NET)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/host"
            },
            "command": "dotnet",
            "args": ["clean"],
            "problemMatcher": []
        }
    ]
}
