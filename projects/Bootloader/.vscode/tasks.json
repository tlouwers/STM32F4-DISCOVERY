{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [

        // ── Firmware (target/, cross-compiled — builds both blink apps) ──────
        {
            "label": "Configure - Firmware [Debug]",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/target"
            },
            "command": "cmake",
            "args": [
                "-B./build",
                "-GNinja",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/target/arm-none-eabi-gcc.cmake",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Configure - Firmware [Release]",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/target"
            },
            "command": "cmake",
            "args": [
                "-B./build",
                "-GNinja",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/target/arm-none-eabi-gcc.cmake",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build - Firmware (all)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/target/build"
            },
            "command": "ninja",
            "problemMatcher": []
        },
        {
            "label": "Build - Blink Green",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/target/build"
            },
            "command": "ninja",
            "args": ["blink_green.elf"],
            "problemMatcher": []
        },
        {
            "label": "Build - Blink Orange",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/target/build"
            },
            "command": "ninja",
            "args": ["blink_orange.elf"],
            "problemMatcher": []
        },

        // ── Firmware Unit Tests (native PC) ──────────────────────────────────
        {
            "label": "Configure - Unit Tests",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "cmake",
            "args": [
                "-B./build",
                "-GNinja",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build - Unit Tests",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "command": "ninja",
            "problemMatcher": []
        },
        {
            "label": "Run - Unit Tests",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build/tests"
            },
            "command": "./TestRunner",
            "problemMatcher": []
        },
        {
            // https://www.gcovr.com/en/stable/guide.html
            "label": "Coverage - Unit Tests",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "gcovr",
            "args": [
                "-r", ".",
                "--object-directory", "${workspaceFolder}/build/tests/CMakeFiles/TestRunner.dir",
                "--html-details",
                "-o", "${workspaceFolder}/build/coverage.html",
                "-j", "4"
            ],
            "problemMatcher": []
        },

        // ── Host Application (.NET 8) ───────────────────────────────────────
        {
            "label": "Build - Host App (.NET)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/host"
            },
            "command": "dotnet",
            "args": ["build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Test - Host App (.NET)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/host"
            },
            "command": "dotnet",
            "args": ["test", "--verbosity", "normal"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run - Host App (.NET)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/host"
            },
            "command": "dotnet",
            "args": ["run", "--project", "BootloaderTool"],
            "problemMatcher": []
        },
        {
            "label": "Clean - Host App (.NET)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/host"
            },
            "command": "dotnet",
            "args": ["clean"],
            "problemMatcher": []
        }
    ]
}
