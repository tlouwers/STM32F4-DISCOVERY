<!--
    App.axaml — Avalonia application definition. Loads the Fluent theme (forced
    Light to match the design), defines the shared colour palette and the styled
    controls (accent/secondary buttons, cards, numbered step badges, the
    connection spinner and status dots). The main window is created in
    App.axaml.cs. Part of the BootloaderTool host application.
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BootloaderTool.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <!-- Palette -->
        <Color x:Key="AccentColor">#5468FF</Color>
        <Color x:Key="AccentColorSoft">#7E8CFF</Color>

        <SolidColorBrush x:Key="AccentBrush"        Color="#5468FF" />
        <SolidColorBrush x:Key="PageBackground"     Color="#FFFFFF" />
        <SolidColorBrush x:Key="StripBackground"    Color="#F5F6FA" />
        <SolidColorBrush x:Key="CardBackground"     Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder"         Color="#E6E8EF" />
        <SolidColorBrush x:Key="TextPrimary"        Color="#20243A" />
        <SolidColorBrush x:Key="TextSecondary"      Color="#8A90A2" />
        <SolidColorBrush x:Key="TextMuted"          Color="#AEB3C2" />
        <SolidColorBrush x:Key="DangerBrush"        Color="#D24B4B" />
        <SolidColorBrush x:Key="DangerSoftBg"       Color="#FCEDED" />
        <SolidColorBrush x:Key="DangerSoftBorder"   Color="#F3C9C9" />
        <SolidColorBrush x:Key="BadgeInactiveBg"    Color="#EEF0F6" />
        <SolidColorBrush x:Key="BadgeInactiveFg"    Color="#9AA0B0" />
        <SolidColorBrush x:Key="DotIdle"            Color="#C2C7D2" />
        <SolidColorBrush x:Key="DotConnected"       Color="#2EBD6B" />
        <SolidColorBrush x:Key="DropZoneBorder"     Color="#CBD0DE" />
        <SolidColorBrush x:Key="SpinnerTrack"       Color="#E3E6EF" />
        <SolidColorBrush x:Key="DoneSoftBg"         Color="#F1FAF4" />
        <SolidColorBrush x:Key="DoneSoftBorder"     Color="#BFE3CD" />

        <!-- Accent gradients (buttons + accent lines) -->
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#5468FF" Offset="0" />
            <GradientStop Color="#7E8CFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#4658F0" Offset="0" />
            <GradientStop Color="#6E7CF5" Offset="1" />
        </LinearGradientBrush>

        <!-- Brighter line used for thin accent rules -->
        <LinearGradientBrush x:Key="AccentLineBrush" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#5468FF" Offset="0" />
            <GradientStop Color="#8A95FF" Offset="0.5" />
            <GradientStop Color="#B7BEFF" Offset="1" />
        </LinearGradientBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Window surface -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource PageBackground}" />
        </Style>

        <!-- Card container -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <!-- Satisfied step: faint green tint once the card's prerequisite is met -->
        <Style Selector="Border.card.done">
            <Setter Property="Background" Value="{StaticResource DoneSoftBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource DoneSoftBorder}" />
        </Style>

        <!-- Folded Activity bar: a subtle clickable strip below card 3 that
             unfolds the activity log overlay. Styled like a flat card row. -->
        <Style Selector="Button.activityBar">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Button.activityBar /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource StripBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.activityBar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EDEFF6" />
        </Style>

        <!-- Light-grey chevron button that expands / collapses the activity log -->
        <Style Selector="Button.activityToggle">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.activityToggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.activityToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E4E7EF" />
        </Style>

        <!-- Numbered step badge -->
        <Style Selector="Border.stepBadge">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.stepBadge > TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Headings / text helpers -->
        <Style Selector="TextBlock.h1">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.subtle">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>

        <!-- Primary (accent) button -->
        <Style Selector="Button.accent">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentGradientHoverBrush}" />
        </Style>
        <Style Selector="Button.accent:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
        </Style>

        <!-- Secondary (outlined) button -->
        <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- Window-chrome buttons (min / max / close) -->
        <Style Selector="Button.chrome">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chrome /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E4E7EF" />
        </Style>
        <Style Selector="Button.chromeClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E81123" />
        </Style>
        <Style Selector="Button.chromeClose:pointerover Path">
            <Setter Property="Stroke" Value="White" />
        </Style>

        <!-- Connection spinner: an accent arc rotating over a faint track -->
        <Style Selector="Path.spinnerArc">
            <Setter Property="RenderTransform">
                <RotateTransform />
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        </Style>
        <Style Selector="Path.spinnerArc">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0.0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>

</Application>
